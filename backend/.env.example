# Geçici şifre e-postası ayarları — bu dosyayı `.env` adıyla kopyalayıp doldur.
# `.env` git tarafından yok sayılır; uygulama şifresini ASLA repoya commit'leme.
#
#   cp .env.example .env
#   docker compose up -d --force-recreate backend
#
# Gmail için:
#   1. Google hesabında 2 adımlı doğrulama AÇIK olmalı.
#   2. https://myaccount.google.com/apppasswords adresinden 16 haneli bir
#      "uygulama şifresi" üret. Normal hesap şifresi ÇALIŞMAZ.
#   3. Şifreyi boşluklarıyla ("abcd efgh ijkl mnop") yapıştırabilirsin;
#      MailService boşlukları kendisi temizler.

# SMTP kullanıcı adı olarak BU adres kullanılır (MailSettings:Username alanı
# tanımlı ama MailService tarafından okunmuyor) — gönderen adresle aynı olmalı.
MAIL_FROM=
MAIL_PASSWORD=

# Aşağıdakiler opsiyonel; boş bırakılırsa parantez içindeki varsayılan geçerli.
MAIL_SMTP_SERVER=smtp.gmail.com   # (smtp.gmail.com)
MAIL_PORT=587                     # (587) — 465 KULLANMA, .NET implicit TLS desteklemez
MAIL_SENDER_NAME=PermitFlow       # (PermitFlow) — boş olamaz, boşsa mail gönderimi hata verir
